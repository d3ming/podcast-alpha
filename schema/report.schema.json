{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report.json: daily podcast intel",
  "type": "object",
  "required": ["date", "title", "run_dir", "key_insights", "essential", "episodes"],
  "additionalProperties": false,
  "$defs": {
    "cite": {
      "type": "object",
      "required": ["text", "speaker", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "speaker": {"type": "string", "description": "name from the transcript, else role, else unknown"},
        "timestamp": {"type": ["integer", "null"], "minimum": 0, "description": "seconds; null only when the transcript has none"},
        "our_read": {"type": "string", "description": "optional: only when it adds a view"}
      }
    }
  },
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "title": {"type": "string"},
    "run_dir": {"type": "string"},
    "key_insights": {"type": "array", "minItems": 3, "maxItems": 5,
                     "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "essential": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "required": ["episode_id", "headline", "show", "guests"], "additionalProperties": false,
                "properties": {"episode_id": {"type": "string"}, "headline": {"type": "string"}, "show": {"type": "string"},
                               "guests": {"type": "string"},
                               "youtube_url": {"type": "string", "pattern": "^https://(www\\.)?(youtube\\.com/watch\\?v=|youtu\\.be/)"},
                               "listen_url": {"type": "string", "description": "clickable episode page (YouTube/Spotify/Apple preferred); never mp3/tracking"}}}
    },
    "episodes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["episode_id", "headline", "url", "signal", "sections"],
        "additionalProperties": false,
        "properties": {
          "episode_id": {"type": "string"},
          "headline": {"type": "string"},
          "url": {"type": "string"},
          "youtube_url": {"type": "string", "pattern": "^https://(www\\.)?(youtube\\.com/watch\\?v=|youtu\\.be/)"},
          "listen_url": {"type": "string"},
          "signal": {"type": "array", "minItems": 3, "maxItems": 4,
                     "items": {"$ref": "#/$defs/cite"}},
          "interests": {"type": "string", "description": "optional: guest's stakes when talking their book"},
          "sections": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "required": ["title", "body"], "additionalProperties": false,
                      "properties": {"title": {"type": "string"}, "body": {"type": "string"},
                                     "claims": {"type": "array", "items": {"$ref": "#/$defs/cite"}}}}
          }
        }
      }
    }
  }
}
