{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selected.json: must-watch picks for one daily run",
  "type": "object",
  "required": ["date", "run_dir", "selected_by", "episodes"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "run_dir": {"type": "string"},
    "selected_by": {"type": "string"},
    "episodes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["episode_id", "title", "show", "url", "guests", "kind", "why"],
        "additionalProperties": false,
        "properties": {
          "episode_id": {"type": "string"},
          "title": {"type": "string"},
          "show": {"type": "string"},
          "url": {"type": "string"},
          "youtube_url": {"type": "string", "pattern": "^https://(www\\.)?(youtube\\.com/watch\\?v=|youtu\\.be/)", "description": "verified YouTube video of this episode; omit rather than guess"},
          "youtube_published": {"type": "string", "description": "YouTube upload date (YYYY-MM-DD) seen in search results"},
          "listen_url": {"type": "string", "description": "YouTube/Spotify/Apple episode page or feed episode page; never audio/tracking"},
          "guests": {"type": "array", "items": {"type": "object", "required": ["name"], "additionalProperties": false,
                     "properties": {"name": {"type": "string"}, "role": {"type": "string"}}}},
          "kind": {"enum": ["exec", "investor", "analyst", "other"]},
          "has_transcript": {"type": "boolean"},
          "fallback_text": {"type": "boolean", "description": "manifest fallback_text: only a show description, no real transcript"},
          "rerun": {"type": "boolean"},
          "why": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}
